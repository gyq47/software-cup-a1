FROM loongarch64/python:3.9

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_DEFAULT_TIMEOUT=120 \
    DISABLE_CHROMA=false \
    DISABLE_LOCAL_EMBEDDING=true \
    DISABLE_PDF_PREVIEW=true \
    DISABLE_IMAGE_KNOWLEDGE=true \
    PIP_ONLY_BINARY=chromadb,chroma-hnswlib,onnxruntime,grpcio,tokenizers,orjson,numpy

WORKDIR /app

COPY requirements-core-py39.txt requirements-rag-optional.txt requirements-extra-optional.txt ./
COPY wheels ./wheels

RUN apt-get update \
      -o Acquire::AllowInsecureRepositories=true \
      -o Acquire::AllowDowngradeToInsecureRepositories=true \
    && apt-get install -y --allow-unauthenticated \
      build-essential python3-dev pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install "pip==23.0.1" "setuptools==68.2.2" "wheel==0.42.0" \
    && python -m pip install \
      --no-index \
      --find-links=/app/wheels \
      "numpy==1.26.4" \
      "chromadb==0.4.24" \
    && python -m pip install \
      --find-links=/app/wheels \
      -r requirements-core-py39.txt

COPY backend ./backend
COPY scripts/start_backend_loongarch.sh ./scripts/start_backend_loongarch.sh
COPY scripts/test_chromadb_py39.py ./scripts/test_chromadb_py39.py
COPY scripts/verify_py39_backend.sh ./scripts/verify_py39_backend.sh

RUN chmod +x ./scripts/start_backend_loongarch.sh ./scripts/verify_py39_backend.sh

EXPOSE 8000

CMD ["./scripts/start_backend_loongarch.sh"]
